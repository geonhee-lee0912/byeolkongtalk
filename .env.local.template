# 별콩톡 환경변수 템플릿
# 로컬 개발은 dev Supabase/카카오/토스 인스턴스를 가리켜야 합니다.
# prod 리소스로 로컬 돌리기 금지 — 사고 위험.

# ─────────── Claude API ───────────
CLAUDE_API_KEY=

# ─────────── 보조 모델 (OpenAI·Gemini) ───────────
# OpenAI 키 — 상담 chat·무료 데일리 운세 모델(필수, /api/health 가 검사). dev/prod 같은 값 써도 됨
OPENAI_API_KEY=
# Gemini 키 — gemini 모델을 고를 때만 쓰임, 비우면 미사용. dev/prod 같은 값 써도 됨
GEMINI_API_KEY=

# ─────────── 카카오 (dev 앱) ───────────
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao
NEXT_PUBLIC_KAKAO_JS_KEY=
KAKAO_ADMIN_KEY=
# 카카오 앱 ID(숫자) — 앱 로그인 토큰 검증용, 비우면 앱 카카오 로그인 503. dev/prod 다른 값(카카오 앱이 분리됨)
KAKAO_APP_ID=

# ─────────── 토스페이먼츠 (테스트 키) ───────────
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_
TOSS_SECRET_KEY=test_sk_

# ─────────── Supabase (dev 프로젝트) ───────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────── App ───────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─────────── 보안 ───────────
# 32자 hex 시크릿 (어드민 쿠키 HMAC-SHA256 서명용)
# 생성: openssl rand -hex 16 — dev/prod 반드시 다른 값
AUTH_TOKEN_SECRET=

# 앱 로그인 액세스 토큰 서명 시크릿(32자 이상) — 비우면 앱 로그인 503. dev/prod 반드시 다른 값
APP_ACCESS_TOKEN_SECRET=

# ─────────── 애플 로그인 (비우면 애플 로그인 비활성 — 웹 기존 기능은 그대로) ───────────
# 웹 애플 로그인 Services ID — 비우면 apple_not_configured. dev/prod 다른 값(콜백 도메인 기준)
APPLE_SERVICES_ID=
# iOS 앱 Bundle ID — 앱 애플 로그인 토큰 검증용, 비우면 앱 애플 로그인 503. dev/prod 다른 값(dev 는 .dev 접미 번들)
APPLE_BUNDLE_ID=
# 애플 개발자 Team ID — client_secret 서명용. dev/prod 같은 값
APPLE_TEAM_ID=
# Sign in with Apple 키 ID — client_secret 서명용. dev/prod 같은 값(키가 하나면)
APPLE_KEY_ID=
# Sign in with Apple 개인키(.p8, 한 줄이면 \n 로) — 운영 자격증명, 클라우드 환경에 넣지 말 것. dev/prod 같은 값(키가 하나면)
APPLE_PRIVATE_KEY=
# 애플 리프레시 토큰 보관 암호화 키(32바이트 base64, openssl rand -base64 32). dev/prod 반드시 다른 값
APPLE_TOKEN_ENC_KEY=

# ─────────── Meta 광고 트래킹 (Phase 4에서 발급) ───────────
# 비우면 Pixel/CAPI 모두 no-op — 코드는 안전하게 통과
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Meta 광고 계정 API 토큰 — 광고비 동기화 cron 용, 운영 전용·클라우드 환경에 넣지 말 것. prod 에만 둠
META_ADS_ACCESS_TOKEN=
# Meta 광고 계정 ID — 광고비 동기화 cron 용, 운영 전용·클라우드 환경에 넣지 말 것. prod 에만 둠
META_AD_ACCOUNT_ID=

# ─────────── Cron ───────────
# Vercel Cron 호출 인증(Bearer) — 비우면 cron 라우트 전부 거부. 운영 전용·클라우드 환경에 넣지 말 것. prod 에만 둠
CRON_SECRET=

# ─────────── 선택 ───────────
# GA4 측정 ID — 비우면 GA 비활성
NEXT_PUBLIC_GA_ID=

# 어드민 콘솔 화이트리스트 — users.id UUID 콤마 구분, 비우면 모두 차단
ADMIN_USER_IDS=

# SEO 검색엔진 소유확인 (선택). prod 스코프에만 등록 후 재배포 필요.
# 네이버 서치어드바이저 / 구글 서치콘솔의 "HTML 태그" content 값.
NAVER_SITE_VERIFICATION=
GOOGLE_SITE_VERIFICATION=

# QA 하네스 전용 chat 모델 전역 오버라이드(예: gpt-5-mini) — 비우면 기본 모델. 로컬 전용, Vercel(dev/prod)엔 넣지 말 것
QA_CHAT_MODEL=
